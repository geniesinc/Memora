# Memora — environment variables for the eval pipeline.
# Copy this file to `.env` and fill in real keys. .env should NOT be committed.

# ----------------------------------------------------------------------------
# Required for Track 1 (LLM eval) and the multi-judge in both tracks.
# All four reported LLMs and all three judges route through OpenRouter — same
# provider used during data generation (see conversation_generation/).
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ----------------------------------------------------------------------------
# Track 2 (memory-agent eval) — answer generation.
# memory_to_answer.py uses OpenAI directly (model: gpt-4o-mini by default) to
# turn retrieved memories into a final answer. Required for ALL six agents.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Track 2 — per-agent keys.
# Only set the keys for agents you intend to run. Local-only agents
# (a_mem, langmem, nemori) need no extra keys beyond OPENAI_API_KEY.
# ----------------------------------------------------------------------------

# Mem0 (cloud)
MEM0_API_KEY=

# Memobase (cloud)
MEMOBASE_API_KEY=
MEMOBASE_PROJECT_URL=https://api.memobase.dev

# MemOS (optional — only set for cloud; leave blank to use a local instance)
MEMOS_API_KEY=
MEMOS_BASE_URL=http://localhost:5230

# LangMem (optional fallback — langmem can use either OpenAI or Anthropic;
# leave blank to use OPENAI_API_KEY only).
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Nemori — optional knobs (all have sensible defaults; uncomment to override).
# ----------------------------------------------------------------------------
# NEMORI_LLM_MODEL=gpt-4o-mini
# NEMORI_USE_OPENROUTER=false
# NEMORI_SEARCH_METHOD=hybrid

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------
# Override the user_id used for storage/retrieval (default: <persona>_<period>).
# MEMORA_USER_ID=
